generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum DriverStatus {
  active
  inactive
  suspended
}

enum ProfileStatus {
  PENDING
  IN_REVIEW
  APPROVED
  REJECTED
  ASSOSSICATED
}

enum VerificationStatus {
  PENDING
  IN_REVIEW
  APPROVED
  REJECTED
}

model Organisation {
  id            String       @id @default(uuid())
  name          String
  email         String       @unique
  phone         String?
  registrationNumber String? @unique
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  drivers       Driver[]

  @@map("organisations")
}

model Driver {
  id             String         @id @default(uuid())
  name           String
  email          String         @unique
  phone          String
  licenseNumber  String         @unique
  status         DriverStatus   @default(active)
  profileStatus  ProfileStatus  @default(PENDING)
  deviceId       String?
  token          String?

  // Organisation Relation
  organisationId String?
  organisation   Organisation?  @relation(fields: [organisationId], references: [id], onDelete: SetNull)

  // 1-to-1 Relation with Onboarding Details
  details        DriverDetails?

  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@map("drivers")
}

model DriverDetails {
  id                       String             @id @default(uuid())
  driverId                 String             @unique
  driver                   Driver             @relation(fields: [driverId], references: [id], onDelete: Cascade)

  // Personal Information
  dateOfBirth              DateTime?
  address                  String?
  city                     String?
  state                    String?
  postalCode               String?
  profilePhotoUrl          String?
  nationalIdNumber         String?            // SSN / Aadhaar / National ID
  nationalIdDocumentUrl    String?

  // Driving & License Information
  licenseExpiryDate        DateTime?
  licenseFrontDocUrl       String?
  licenseBackDocUrl        String?
  yearsOfExperience        Int?

  // Emergency Contact
  emergencyContactName     String?
  emergencyContactPhone    String?
  emergencyContactRelation String?

  // Banking / Payout Details
  bankName                 String?
  accountHolderName        String?
  bankAccountNumber        String?
  bankRoutingNumber        String?            // Routing / IFSC / Swift Code

  // Onboarding Workflow & Work Preferences
  registrationType         String             @default("INDEPENDENT") // INDEPENDENT or FLEET_ATTACHED
  openForHire              Boolean            @default(true)
  preferredOperatingHub    String?
  vehicleCategories        String[]           @default([])
  onboardingStep           Int                @default(1)
  isCompleted              Boolean            @default(false)
  verificationStatus       VerificationStatus @default(PENDING)
  rejectionReason          String?
  submittedAt              DateTime?
  verifiedAt               DateTime?

  createdAt                DateTime           @default(now())
  updatedAt                DateTime           @updatedAt

  @@map("driver_details")
}
